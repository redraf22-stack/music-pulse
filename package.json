{
  "name": "music-pulse",
  "productName": "Music Pulse",
  "version": "1.0.0",
  "description": "Твой вайб. Твои люди. Один пульс.",
  "main": "main.js",
  "author": "Music Pulse Team",
  "appId": "com.musicpulse.app",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:publish": "electron-builder --win --x64 --publish always",
    "download-icon": "node download-icon.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "music-metadata": "^8.1.4",
    "simple-peer": "^9.11.1",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.10"
  },
  "devDependencies": {
    "dotenv": "^16.3.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-updater": "^6.1.7"
  },
  "build": {
    "appId": "com.musicpulse.app",
    "productName": "Music Pulse",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
	  "provider": "github",
	  "owner": "redraf22-stack",
	  "repo": "music-pulse",
	  "private": true
	}
  }
}