{
  "name": "musicpulse",
  "version": "1.8.0",
  "description": "MusicPulse - совместное прослушивание музыки в локальной сети",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "server": "node src/server/index.js",
    "postinstall": "node scripts/fix-peer.js",
    "build": "node scripts/fix-peer.js && electron-builder",
    "build:win": "node scripts/fix-peer.js && electron-builder --win",
    "release": "node scripts/fix-peer.js && electron-builder --win --publish always"
  },
  "author": "RedRaf22",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "^7.14.0",
    "node-forge": "^1.3.1",
    "peer": "^1.0.2",
    "socket.io": "^4.6.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.musicpulse.app",
    "productName": "MusicPulse",
    "asar": true,
    "files": [
      "**/*",
      "!dist/**",
      "!src/music/**",
      "!src/uploads/**",
      "!src/urlcache/**",
      "!**/*.pem",
      "!src/server/url-tracks.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MusicPulse"
    },
    "publish": {
    "provider": "github",
    "owner": "redraf22-stack",
    "repo": "music-pulse",
    "releaseType": "release"
    }
  }
}